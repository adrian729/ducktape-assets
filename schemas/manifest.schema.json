{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/adrian729/ducktape-assets/schemas/manifest.schema.json",
  "title": "Ducktape Assets manifest",
  "description": "Generated by `tools build` for one set at one version; published at the root of the set's delivery package as manifest.json and copied verbatim into the index package under sets/<set>.json. Authored fields are copied from set.yaml and asset.yaml; everything else is measured.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "set",
    "title",
    "version",
    "package",
    "mastersPackage",
    "cdn",
    "license",
    "inputsHash",
    "contentHash",
    "tooling",
    "builtAt",
    "assets"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "set": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "authored",
        "historical",
        "imported"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "package": {
      "description": "Delivery package name (first volume).",
      "type": "string"
    },
    "parts": {
      "description": "Additional delivery volume packages, in order, when the set is too large for one.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mastersPackage": {
      "type": "string"
    },
    "mastersParts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cdn": {
      "description": "Base URL of the first delivery package at this exact version, ending in a slash.",
      "type": "string",
      "format": "uri"
    },
    "license": {
      "type": "object",
      "required": [
        "artwork"
      ],
      "properties": {
        "artwork": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "attribution": {
      "description": "One line consumers may show, generated from set.yaml and provenance.",
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "style": {
      "type": "string"
    },
    "inputsHash": {
      "description": "The publish gate: sha256 over masters, YAML, configuration and tooling versions.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "contentHash": {
      "description": "Integrity only: sha256 over sorted output paths and bytes.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "tooling": {
      "type": "object",
      "required": [
        "tools",
        "sharp",
        "libvips",
        "concurrency"
      ],
      "properties": {
        "tools": {
          "type": "string"
        },
        "sharp": {
          "type": "string"
        },
        "libvips": {
          "type": "string"
        },
        "svgo": {
          "type": "string"
        },
        "concurrency": {
          "description": "sharp.concurrency() the build ran with; libaom output bytes depend on it.",
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "drafts": {
      "description": "Ids of draft assets skipped by this build (status draft: built and previewable, not published). Present only when there are any.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "builtAt": {
      "type": "string",
      "format": "date-time"
    },
    "assets": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "w",
        "h",
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "w": {
          "type": "integer",
          "minimum": 1
        },
        "h": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "description": "Path inside the package that holds it.",
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "package": {
          "description": "Volume package holding this file, when not the first: 'part2', 'part3', …",
          "type": "string",
          "pattern": "^part[0-9]+$"
        }
      }
    },
    "encoding": {
      "description": "The AVIF decision: both top-rung sizes and whether the AVIF ladder was kept (avif bytes <= 0.85 x webp bytes). SVG-only assets still record it for their 2048 px rasterisation.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "avif",
        "webpTopBytes",
        "avifTopBytes"
      ],
      "properties": {
        "avif": {
          "type": "boolean"
        },
        "webpTopBytes": {
          "type": "integer"
        },
        "avifTopBytes": {
          "type": "integer"
        }
      }
    },
    "ladder": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "avif": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "webp": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "svg": {
          "$ref": "#/$defs/file"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "type",
        "categories",
        "subjects",
        "colors",
        "facing",
        "composition",
        "status",
        "render",
        "width",
        "height",
        "transparent",
        "palette",
        "thumbhash",
        "master",
        "sources"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "colors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "facing": {
          "type": "string"
        },
        "view": {
          "type": "string"
        },
        "composition": {
          "type": "string"
        },
        "period": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "style": {
          "type": "string"
        },
        "group": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string"
        },
        "deprecated_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "quality": {
          "type": "string"
        },
        "usage_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "display_width": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "related": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "license": {
          "type": "string"
        },
        "attribution": {
          "type": "string"
        },
        "provenance": {
          "type": [
            "object",
            "null"
          ]
        },
        "render": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "image": {
              "type": "object"
            },
            "tile": {
              "type": "object",
              "required": [
                "axis",
                "period",
                "rotated"
              ],
              "properties": {
                "axis": {
                  "enum": [
                    "x",
                    "y"
                  ]
                },
                "period": {
                  "type": "number"
                },
                "rotated": {
                  "$ref": "#/$defs/ladder"
                }
              }
            },
            "frame": {
              "type": "object",
              "required": [
                "slice",
                "atlas"
              ],
              "properties": {
                "corner": {
                  "type": "string"
                },
                "slice": {
                  "oneOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "object",
                      "required": [
                        "top",
                        "right",
                        "bottom",
                        "left"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "top": {
                          "type": "number"
                        },
                        "right": {
                          "type": "number"
                        },
                        "bottom": {
                          "type": "number"
                        },
                        "left": {
                          "type": "number"
                        }
                      }
                    }
                  ]
                },
                "atlas": {
                  "$ref": "#/$defs/ladder"
                },
                "slicePx": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "description": "Composed atlas (corner + one slice percentage) or ready-made frame (per-side percentages + slicePx on the master); atlas is the ladder to use in border-image.",
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "corner"
                  ],
                  "properties": {
                    "slice": {
                      "type": "number"
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "slicePx"
                  ],
                  "not": {
                    "required": [
                      "corner"
                    ]
                  },
                  "properties": {
                    "slice": {
                      "type": "object"
                    }
                  }
                }
              ]
            }
          }
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "transparent": {
          "type": "boolean"
        },
        "palette": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#[0-9a-f]{6}$"
          }
        },
        "thumbhash": {
          "type": "string"
        },
        "resolutionLimited": {
          "description": "True when the master is narrower than 1024 px, so large requests cannot be served sharply.",
          "type": "boolean"
        },
        "master": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "w",
            "h",
            "bytes",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "w": {
              "type": "integer"
            },
            "h": {
              "type": "integer"
            },
            "bytes": {
              "type": "integer"
            },
            "sha256": {
              "type": "string"
            },
            "package": {
              "type": "string"
            }
          }
        },
        "sources": {
          "$ref": "#/$defs/ladder"
        },
        "encoding": {
          "$ref": "#/$defs/encoding"
        },
        "components": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "master",
              "sources"
            ],
            "properties": {
              "description": {
                "type": "string"
              },
              "master": {
                "type": "object"
              },
              "sources": {
                "$ref": "#/$defs/ladder"
              },
              "encoding": {
                "$ref": "#/$defs/encoding"
              }
            }
          }
        }
      }
    }
  }
}
