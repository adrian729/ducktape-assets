    "arabesque-cartouche": {
      "attribution": "Metropolitan Museum of Art 33.70.39",
      "categories": [
        "scrollwork",
        "knotwork"
      ],
      "colors": [
        "black",
        "brown",
        "gray"
      ],
      "composition": "single-ornament",
      "description": "A wide symmetrical cartouche printed as a near-black brownish ground with the ornament left in reserve, so the arabesque reads as light lines and leaves cut out of the dark field. The outline is scalloped, with pointed ogee finials at top and bottom centre, two knotted interlace loops over the top finial, scrolled lobes at the four corners and squared bracket terminals at left and right. A band of running scrolls frames an inner field of interlaced strapwork and dense leaf scrolls around a central lozenge. Only the dark ink is opaque; the ornament itself is transparent.",
